#include <stdio.h>

int main() {
    float m1, m2, m3, m4, m5, average;

    printf("Enter marks for 5 subjects: ");
    scanf("%f %f %f %f %f", &m1, &m2, &m3, &m4, &m5);

    average = (m1 + m2 + m3 + m4 + m5) / 5;

    printf("Average = %.2f\n", average);

    if (average >= 90)
        printf("Grade = A\n");
    else if (average >= 80)
        printf("Grade = B\n");
    else if (average >= 70)
        printf("Grade = C\n");
    else if (average >= 60)
        printf("Grade = D\n");
    else if (average >= 50)
        printf("Grade = E\n");
    else
        printf("Grade = F\n");

    return 0;
}
