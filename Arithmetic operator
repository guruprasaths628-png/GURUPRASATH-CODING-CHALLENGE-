#include <stdio.h>

int main()
{
    int a, b;

    printf("Enter the value of a and b: ");
    scanf("%d%d", &a, &b);

    printf("\nArithmetic Operators\n");

    printf("+a = %d\n", +a);
    printf("-a = %d\n", -a);
    printf("++a = %d\n", ++a);
    printf("--a = %d\n", --a);
    printf("a++ = %d\n", a++);
    printf("a-- = %d\n", a--);

    printf("\nRelational Operators\n");

    printf("a < b = %d\n", a < b);
    printf("a > b = %d\n", a > b);
    printf("a <= b = %d\n", a <= b);
    printf("a >= b = %d\n", a >= b);
    printf("a == b = %d\n", a == b);
    printf("a != b = %d\n", a != b);

    printf("\nLogical Operators\n");

    printf("a && b = %d\n", a && b);
    printf("a || b = %d\n", a || b);
    printf("!a :%d",!a);

    printf("\nConditional Operator\n");

    (a > b) ? printf("a is greater") : printf("b is greater");

    return 0;
}
