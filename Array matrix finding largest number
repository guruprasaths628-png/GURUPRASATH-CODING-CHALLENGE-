#include <stdio.h>

int main()
{
    int n, max;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    int arr[n];

    printf("Elements = %d\n", n);

    for (int i = 0; i < n; i++)
    {
        scanf("%d", &arr[i]);
    }

    max = arr[0];

    for (int i = 0; i < n; i++)
    {
        if (max < arr[i])
        {
            max = arr[i];
        }
    }

    printf("Max number: %d", max);

    return 0;
}
